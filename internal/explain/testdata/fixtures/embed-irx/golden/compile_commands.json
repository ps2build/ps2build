[
  {
    "directory": "<OUT_DIR>",
    "file": "<PROJECT_ROOT>/src/iop/helper.c",
    "output": "obj/helper/src/iop/helper.o",
    "arguments": [
      "<PS2DEV>/toolchain/iop/bin/mipsel-none-elf-gcc",
      "-D_IOP",
      "-fno-builtin",
      "-G0",
      "-Os",
      "-Wall",
      "-msoft-float",
      "-mno-explicit-relocs",
      "-I<PS2DEV>/toolchain/iop/include",
      "-I<PS2DEV>/packages/core/common/include",
      "-c",
      "<PROJECT_ROOT>/src/iop/helper.c",
      "-o",
      "<OUT_DIR>/obj/helper/src/iop/helper.o"
    ]
  },
  {
    "directory": "<OUT_DIR>",
    "file": "<PROJECT_ROOT>/src/ee/main.c",
    "output": "obj/main/src/ee/main.o",
    "arguments": [
      "<PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-gcc",
      "-D_EE",
      "-G0",
      "-O2",
      "-Wall",
      "-ffunction-sections",
      "-I<PS2DEV>/toolchain/ee/include",
      "-I<PS2DEV>/packages/core/common/include",
      "-I<OUT_DIR>/generated",
      "-c",
      "<PROJECT_ROOT>/src/ee/main.c",
      "-o",
      "<OUT_DIR>/obj/main/src/ee/main.o"
    ]
  },
  {
    "directory": "<OUT_DIR>",
    "file": "<OUT_DIR>/generated/helper_irx.c",
    "output": "obj/_embed/helper_irx.o",
    "arguments": [
      "<PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-gcc",
      "-D_EE",
      "-G0",
      "-c",
      "<OUT_DIR>/generated/helper_irx.c",
      "-o",
      "<OUT_DIR>/obj/_embed/helper_irx.o"
    ]
  }
]
