# Generated by ps2build. Do not edit by hand.

rule ee_cc
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-gcc -MMD -MF $out.d $flags -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC(ee) $out
rule ee_cxx
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-g++ -MMD -MF $out.d $flags -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX(ee) $out
rule iop_cc
  command = <PS2DEV>/toolchain/iop/bin/mipsel-none-elf-gcc -MMD -MF $out.d $flags -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC(iop) $out
rule dvp_as
  command = <PS2DEV>/tools/dvp-as $in -o $out $flags
  description = DVPAS $out
rule ee_link
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-gcc -T$linkfile -o $out $in $flags $libs
  description = LINK(ee) $out
rule ee_link_cxx
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-g++ -T$linkfile -o $out $in $flags $libs
  description = LINK(ee,c++) $out
rule iop_link
  command = <PS2DEV>/toolchain/iop/bin/mipsel-none-elf-gcc -T$linkfile -o $out $in $flags $libs
  description = LINK(iop) $out
rule ee_strip
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-strip $flags -o $out $in
  description = STRIP $out
rule iop_strip
  command = <PS2DEV>/toolchain/iop/bin/mipsel-none-elf-strip $flags -o $out $in
  description = STRIP $out
rule iop_fixup
  command = <PS2DEV>/tools/iopfixup $flags -o $out $in
  description = IOPFIXUP $out
rule bin2c
  command = <PS2DEV>/tools/bin2c $in $out $varname
  description = BIN2C $out
rule ee_objcopy
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-objcopy -O binary $in $out
  description = OBJCOPY $out
rule ee_pack
  command = <PS2DEV>/tools/ps2pack $in $out
  description = PS2PACK $out
rule ee_ar
  command = <PS2DEV>/toolchain/ee/bin/mips64r5900el-ps2-elf-ar rcs $out $in
  description = AR(ee) $out
rule iop_ar
  command = <PS2DEV>/toolchain/iop/bin/mipsel-none-elf-ar rcs $out $in
  description = AR(iop) $out

build obj/helper/src/iop/helper.o: iop_cc <PROJECT_ROOT>/src/iop/helper.c
  flags = -D_IOP$ -fno-builtin$ -G0$ -Os$ -Wall$ -msoft-float$ -mno-explicit-relocs$ -I<PS2DEV>/toolchain/iop/include$ -I<PS2DEV>/packages/core/common/include
build obj/main/src/ee/main.o: ee_cc <PROJECT_ROOT>/src/ee/main.c
  flags = -D_EE$ -G0$ -O2$ -Wall$ -ffunction-sections$ -I<PS2DEV>/toolchain/ee/include$ -I<PS2DEV>/packages/core/common/include$ -I<OUT_DIR>/generated
build obj/_embed/helper_irx.o: ee_cc <OUT_DIR>/generated/helper_irx.c
  flags = -D_EE$ -G0
build obj/helper/helper.notiopmod.elf: iop_link obj/helper/src/iop/helper.o | <PS2DEV>/packages/core/startup/share/iop/linkfile
  linkfile = <PS2DEV>/packages/core/startup/share/iop/linkfile
  flags = -Os$ -nostdlib$ -dc$ -r
  libs = 
build obj/main/main.unstripped.elf: ee_link obj/main/src/ee/main.o obj/_embed/helper_irx.o | <PS2DEV>/packages/core/startup/share/ee/linkfile
  linkfile = <PS2DEV>/packages/core/startup/share/ee/linkfile
  flags = -O2$ -Wl,--gc-sections$ -nostartfiles$ -L<PS2DEV>/toolchain/ee/lib
  libs = 
build obj/helper/helper.notiopmod.stripped.elf: iop_strip obj/helper/helper.notiopmod.elf
  flags = --strip-unneeded$ --remove-section=.pdr$ --remove-section=.comment$ --remove-section=.mdebug.abi32$ --remove-section=.gnu.attributes
build bin/main.elf: ee_strip obj/main/main.unstripped.elf
  flags = --strip-all
build bin/helper.irx: iop_fixup obj/helper/helper.notiopmod.stripped.elf
  flags = --rb$ --irx1$ --allow-zero-text
build <OUT_DIR>/generated/helper_irx.c: bin2c bin/helper.irx
  varname = helper_irx

build helper: phony bin/helper.irx
build main: phony bin/main.elf

build all: phony helper main
default all
